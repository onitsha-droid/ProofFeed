{
  "name": "@prooffeed/indexer",
  "version": "0.1.0",
  "description": "ProofFeed Soroban event indexer",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "migrate": "node -r ts-node/register src/db/migrate.ts",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "12.3.0",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.18.2",
    "pg": "8.11.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/node": "20.11.5",
    "@types/pg": "8.11.2",
    "jest": "29.7.0",
    "ts-jest": "29.1.2",
    "ts-node": "10.9.2",
    "typescript": "5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/*.test.ts"]
  }
}
